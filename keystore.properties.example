# Copy this file to keystore.properties (repo root, gitignored) and fill in
# real values to enable a signed release build (./gradlew assembleRelease).
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore app/release-key.jks -alias <yourAlias> \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Without this file, `assembleRelease` still succeeds but produces an
# unsigned APK (app-release-unsigned.apk) that Android refuses to install
# ("no certificates") — use the debug build (app-debug.apk, signed
# automatically by the Android Gradle Plugin's debug keystore) for local
# testing instead, or set this up for a real signed release/sideload build.
storeFile=app/release-key.jks
storePassword=changeit
keyAlias=changeit
keyPassword=changeit
